# benchwarmer.ai backend environment template
# From the repository root: cp .env.example agent-backend/.env
# Frontend settings use frontend-vite/.env.example instead.
# Add real credentials only to your local .env files.

# Anthropic agents (implementation, plotting, and optional Claude intake)
ANTHROPIC_API_KEY=

# Optional hosted Nemotron / OpenAI-compatible endpoint
# Uncomment and configure these for your inference server.
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Set one of these keys when your endpoint requires authentication.
NEMOTRON_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Optional Modal credentials (or use your local Modal authentication)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
